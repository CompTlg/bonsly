<!--
  SPPM seam test: the floor is made of two coplanar tiles (separate instances) and the sphere rests on it.
  A photon gather must treat the tiles as one surface (a seam between two tiles must stay invisible), and
  must not get confused where the sphere touches the floor. Instance identity is not a valid way to
  decide that two photons landed on the same surface.
  The camera looks at the tile seam, the contact of the sphere and two wall seams.
  The reference comes from YOUR path tracer at 8192 spp: see tests/sppm/tools/seam_tiles_reference.xml
-->
<test type="image" id="seam_tiles" mae="0.0045" me="2e-4">
    <integrator type="sppm" depth="5" photonsPerIteration="200000" alpha="0.6666667">
        <scene id="scene">
            <camera type="perspective" id="camera">
                <integer name="width" value="128"/>
                <integer name="height" value="128"/>
                <string name="fovAxis" value="x"/>
                <float name="fov" value="25"/>
                <transform>
                    <rotate axis="1,0,0" angle="-25"/>
                    <translate x="0.45" y="-0.4" z="-3"/>
                </transform>
            </camera>

            <bsdf type="diffuse" id="wall material">
                <texture name="albedo" type="constant" value="0.8"/>
            </bsdf>

            <instance id="back">
                <shape type="rectangle"/>
                <ref id="wall material"/>
                <transform>
                    <scale z="-1"/>
                    <translate z="1"/>
                </transform>
            </instance>
            <instance id="floor tile A">
                <shape type="rectangle"/>
                <ref id="wall material"/>
                <transform>
                    <scale x="0.775"/>
                    <translate x="-0.225"/>
                    <rotate axis="1,0,0" angle="90"/>
                    <translate y="1"/>
                </transform>
            </instance>
            <instance id="floor tile B">
                <shape type="rectangle"/>
                <ref id="wall material"/>
                <transform>
                    <scale x="0.225"/>
                    <translate x="0.775"/>
                    <rotate axis="1,0,0" angle="90"/>
                    <translate y="1"/>
                </transform>
            </instance>
            <instance id="ceiling">
                <shape type="rectangle"/>
                <ref id="wall material"/>
                <transform>
                    <rotate axis="1,0,0" angle="-90"/>
                    <translate y="-1"/>
                </transform>
            </instance>
            <instance id="left wall">
                <shape type="rectangle"/>
                <bsdf type="diffuse">
                    <texture name="albedo" type="constant" value="0.8,0.1,0.1"/>
                </bsdf>
                <transform>
                    <rotate axis="0,1,0" angle="90"/>
                    <translate x="-1"/>
                </transform>
            </instance>
            <instance id="right wall">
                <shape type="rectangle"/>
                <bsdf type="diffuse">
                    <texture name="albedo" type="constant" value="0.1,0.8,0.1"/>
                </bsdf>
                <transform>
                    <rotate axis="0,1,0" angle="-90"/>
                    <translate x="1"/>
                </transform>
            </instance>

            <instance>
                <shape type="sphere"/>
                <bsdf type="diffuse">
                    <texture name="albedo" type="constant" value="0.8"/>
                </bsdf>
                <transform>
                    <scale value="0.5"/>
                    <translate y="0.5" z="-0.1"/>
                </transform>
            </instance>

            <!-- invisible area light just below the ceiling, facing down -->
            <light type="area">
                <instance>
                    <shape type="rectangle"/>
                    <emission type="lambertian">
                        <texture name="emission" type="constant" value="12"/>
                    </emission>
                    <transform>
                        <scale value="0.35"/>
                        <rotate axis="1,0,0" angle="-90"/>
                        <translate y="-0.98"/>
                    </transform>
                </instance>
            </light>
        </scene>
        <sampler type="halton" count="64"/>
    </integrator>
</test>
